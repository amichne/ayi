#!/usr/bin/env bash
set -euo pipefail

ayi_source="${BASH_SOURCE[0]}"
while [ -L "$ayi_source" ]; do
    ayi_parent="$(cd "$(dirname "$ayi_source")" && pwd -P)"
    ayi_source="$(readlink "$ayi_source")"
    [[ "$ayi_source" = /* ]] || ayi_source="$ayi_parent/$ayi_source"
done
ayi_root="$(cd "$(dirname "$ayi_source")/.." && pwd -P)"
export AYI_CALLER_DIR="$PWD"

case "${1:-new}" in
    help|-h|--help)
        printf '%s\n' \
            'Usage: ayi new [--force] <name> [prompt]' \
            '       ayi modify [--force] <name> [prompt] | explain <name>' \
            '       ayi list | install <plan|apply|uninstall>' \
            '' 'Run ayi with no arguments for an interactive tool interview.' \
            'Created tools are installed in ~/.local/bin; invoke <name> directly.' \
            '--force replaces existing tools or executable files/links, not directories or dirty registry files.'
        exit 0 ;;
    new|modify|explain)
        exec uv run --locked --no-dev --project "$ayi_root" python "$ayi_root/factory.py" "$@" ;;
    list)
        [ "$#" -eq 1 ] || { printf 'ayi: usage: ayi list\n' >&2; exit 64; }
        exec mise -C "$ayi_root" tasks ls --local ;;
    install)
        shift
        exec uv run --locked --no-dev --project "$ayi_root" python "$ayi_root/install.py" "$@" ;;
    *) printf 'ayi: unknown action: %s\n' "$1" >&2; exit 64 ;;
esac
