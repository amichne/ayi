#!/usr/bin/env bash
set -euo pipefail

ayi_source="${BASH_SOURCE[0]}"
while [ -L "$ayi_source" ]; do
    ayi_parent="$(cd "$(dirname "$ayi_source")" && pwd -P)"
    ayi_source="$(readlink "$ayi_source")"
    [[ "$ayi_source" = /* ]] || ayi_source="$ayi_parent/$ayi_source"
done
ayi_root="$(cd "$(dirname "$ayi_source")/.." && pwd -P)"
export AYI_CALLER_DIR="$PWD"

case "${1:-new}" in
    help|-h|--help)
        printf '%s\n' \
            'Usage: ayi new [--force] <name> [prompt]' \
            '       ayi modify [--force] <name> [prompt] | explain <name>' \
            '       ayi sessions | resume <id> | fork <id> [--checkpoint N] | review <id>' \
            '       --design-model MODEL --implementation-harness pi|codex --implementation-model MODEL' \
            '       ayi list | install <plan|apply|uninstall>' \
            '       ayi update | --version | -V' \
            '       ayi shell init zsh | complete < request.json' \
            '' 'Run ayi with no arguments for an interactive tool interview.' \
            'Created tools are installed in ~/.local/bin; invoke <name> directly.' \
            '--force replaces existing tools or executable files/links, not directories or dirty registry files.'
        exit 0 ;;
    update|--version|-V)
        if [ -x "$ayi_root/.venv/bin/python" ]; then
            exec "$ayi_root/.venv/bin/python" -B "$ayi_root/bootstrap.py" "$@"
        fi
        exec uv run --offline --no-project --no-build --python 3.12 python -B "$ayi_root/bootstrap.py" "$@" ;;
    new|modify|explain|sessions|resume|fork|review)
        exec uv run --locked --no-dev --project "$ayi_root" python "$ayi_root/factory.py" "$@" ;;
    list)
        [ "$#" -eq 1 ] || { printf 'ayi: usage: ayi list\n' >&2; exit 64; }
        exec uv run --locked --no-dev --project "$ayi_root" python "$ayi_root/factory.py" list ;;
    install)
        shift
        exec uv run --locked --no-dev --project "$ayi_root" python "$ayi_root/install.py" "$@" ;;
    shell)
        shift
        [ -x "$ayi_root/.venv/bin/python" ] || { printf 'ayi: initialize the locked runtime with ayi install plan first\n' >&2; exit 69; }
        exec "$ayi_root/.venv/bin/python" -B "$ayi_root/shell.py" "$@" ;;
    complete)
        shift
        [ -x "$ayi_root/.venv/bin/python" ] || { printf 'ayi: initialize the locked runtime with ayi install plan first\n' >&2; exit 69; }
        export PYDANTIC_DISABLE_PLUGINS=__all__
        exec "$ayi_root/.venv/bin/python" -B "$ayi_root/completion.py" "$@" ;;
    *) printf 'ayi: unknown action: %s\n' "$1" >&2; exit 64 ;;
esac
